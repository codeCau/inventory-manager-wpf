<ui:FluentWindow x:Class="ControleEstoqueWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ControleEstoqueWPF.ViewModels"
        xmlns:conv="clr-namespace:ControleEstoqueWPF.Converters"
        Title="Controle de Estoque &amp; Produtos" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <conv:EstoqueBadgeConverter x:Key="BadgeConverter" />
        <conv:EstoqueColorConverter x:Key="ColorConverter" />
    </ui:FluentWindow.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:InfoBar Grid.Row="0"
                    Title="Notificação de Estoque"
                    Message="{Binding MensagemAlerta}"
                    IsOpen="{Binding MostrarAlerta}"
                    Severity="Warning"
                    Margin="0,0,0,15" />

        <TextBlock Grid.Row="1" Text="Cadastro e Controle de Produtos" 
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

        <ui:Card Grid.Row="2" Margin="0,0,0,20" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Nome do Produto *" Margin="0,0,0,5"/>
                    <ui:TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ex: Teclado Mecânico"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Descrição" Margin="0,0,0,5"/>
                    <ui:TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Opcional"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="Preço (R$) *" Margin="0,0,0,5"/>
                    <ui:TextBox Text="{Binding Preco, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="5">
                    <TextBlock Text="Qtd Estoque *" Margin="0,0,0,5"/>
                    <ui:TextBox Text="{Binding QuantidadeEstoque, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="5">
                    <ui:Button Content="Salvar" Command="{Binding SalvarProdutoCommand}" Appearance="Primary" Margin="0,0,5,0"/>
                    <ui:Button Content="Limpar" Command="{Binding LimparFormularioCommand}" Appearance="Secondary"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <DataGrid Grid.Row="3" 
                  ItemsSource="{Binding Produtos}" 
                  SelectedItem="{Binding ProdutoSelecionado}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*"/>
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="2*"/>
                <DataGridTextColumn Header="Preço" Binding="{Binding Preco, StringFormat=C2}" Width="100"/>
                <DataGridTextColumn Header="Qtd" Binding="{Binding QuantidadeEstoque}" Width="70"/>

                <DataGridTemplateColumn Header="Status do Nível" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center"
                                    Background="{Binding QuantidadeEstoque, Converter={StaticResource ColorConverter}}">
                                <TextBlock Text="{Binding QuantidadeEstoque, Converter={StaticResource BadgeConverter}}" 
                                           Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Ações" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:Button Content="Editar" 
                                           Command="{Binding DataContext.PrepararEdicaoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}" 
                                           Margin="0,0,5,0" Padding="8,2"/>
                                <ui:Button Content="Excluir" 
                                           Command="{Binding DataContext.ExcluirProdutoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}" 
                                           Appearance="Danger" Padding="8,2"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</ui:FluentWindow>
